{
  "name": "ig_system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestão para igrejas (Google Apps Script) — suíte de testes",
  "scripts": {
    "test": "node --test tests/suite.test.js",
    "test:static": "node --test tests/static.test.js",
    "test:ui": "node --test tests/ui.test.js",
    "ui:baseline": "node tests/helpers/ui-escalas.js --gravar",
    "test:runtime": "node --test tests/runtime.test.js",
    "preview": "node tests/preview/preview.js",
    "empacotar": "node scripts/empacotar-cliente.js",
    "e2e": "node --test \"tests/e2e/*.e2e.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "qrcode-generator": "^1.4.4"
  }
}
